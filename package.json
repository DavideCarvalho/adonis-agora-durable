{
  "name": "adonis-durable",
  "version": "0.1.0",
  "private": true,
  "description": "Durable cross-app workflows for the Agora AdonisJS ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-durable.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "v26.7.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "pnpm --filter './packages/*' build && changeset publish",
    "version-packages": "changeset version && node scripts/sync-version-literals.mjs && biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@swc/core": "1.15.47",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.10",
    "vitest": "3.2.7"
  }
}
