{
  "name": "adonis-durable",
  "version": "0.1.0",
  "private": true,
  "description": "Durable cross-app workflows for the Agora AdonisJS ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-durable.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "check:package": "node scripts/check-package.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "pnpm --filter './packages/*' build && changeset publish",
    "version-packages": "changeset version && node scripts/sync-version-literals.mjs && biome check --write .",
    "check:agora-doctor": "node scripts/check-agora-doctor.mjs --reference-dir packages/adonis/dist/agora-doctor"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.6",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@swc/core": "1.16.22",
    "publint": "0.3.25",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
