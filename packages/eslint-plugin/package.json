{
  "name": "@adonis-agora/durable-eslint-plugin",
  "version": "0.2.2",
  "description": "ESLint rules enforcing workflow determinism for @adonis-agora/durable — flags Date.now()/Math.random()/new Date()/crypto.randomUUID() inside workflow bodies. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-durable.git",
    "directory": "packages/eslint-plugin"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist/", "README.md", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run check:dist",
    "check:dist": "node ../../scripts/assert-build-output.mjs dist src/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.67.0"
  },
  "peerDependencies": {
    "eslint": "^8.57.0 || ^9.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/rule-tester": "8.67.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": ["eslint", "eslint-plugin", "durable", "workflow", "determinism", "agora"]
}
