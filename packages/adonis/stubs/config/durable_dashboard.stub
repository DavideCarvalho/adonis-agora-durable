import { defineConfig } from '@adonis-agora/durable/dashboard'

/**
 * Configuration for the @adonis-agora/durable console.
 *
 * Without \`authorize\` the console is open outside production and answers 403
 * to every request in production. Set \`authorize\` to choose who may open it:
 * a function, an authorizer class, or a lazy import of one
 * (\`() => import('#policies/console_access')\`). It returns a boolean,
 * \`{ allowed, reason?: 'unauthenticated' | 'forbidden' }\` (\`'unauthenticated'\`
 * answers 401, any other denial 403) or \`{ redirectTo }\`. For scripts, use
 * \`authorizeByToken({ token: env.get('CONSOLE_TOKEN') })\`.
 */
export default defineConfig({
  // enabled: true,
  // path: '/durable',
  // authorize: (ctx) => ctx.auth.user?.isAdmin === true,
  // authorize: () => import('#policies/console_access'),
})
